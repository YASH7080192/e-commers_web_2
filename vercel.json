{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/api?__path=/uploads/$1" },
    { "source": "/sitemap.xml", "destination": "/api?__path=/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api?__path=/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
